# ──────────────────────────────────────────────
# 헤어이어 환경변수 템플릿
# 복사 후 .env 로 저장하고 실제 값으로 채워주세요.
# Vercel 배포 시: Project Settings → Environment Variables 에 등록
# ──────────────────────────────────────────────

# 카카오 REST API 키 (서버 전용 — 절대 브라우저에 노출 금지)
# Kakao Developers Console → 내 애플리케이션 → REST API 키
KAKAO_REST_KEY=your_kakao_rest_api_key_here

# 카카오 JavaScript SDK 키 (브라우저에서 지도 표시용)
# Kakao Developers Console → 내 애플리케이션 → JavaScript 키
KAKAO_JS_KEY=your_kakao_javascript_key_here

# Supabase
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 로컬 개발 서버 포트
PORT=3000
